DOMAIN=chat.example.com
POSTGRES_DB=vocreborn
POSTGRES_USER=vocreborn
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://vocreborn:replace_with_url_encoded_password@postgres:5432/vocreborn?schema=public
METRICS_TOKEN=replace_with_a_long_random_metrics_token
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=TUSOVA <no-reply@example.com>

# Cloudflare Turnstile secret key for server-side guest captcha verification
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret
