DATABASE_URL="postgresql://vocreborn:vocreborn_dev@localhost:5432/vocreborn?schema=public"
API_PORT=3001
WEB_ORIGIN="http://localhost:3000"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="TUSOVA <no-reply@tusova.local>"
SMTP_ALLOW_INSECURE=true
# Тестовые боты включены только на локалке; в production они выключены.
TUSOVA_BOTS_ENABLED=true
# Радио выключено до запуска отдельного аудиосервиса; цена заказа по умолчанию 5.
TUSOVA_RADIO_ENABLED=false
# Service quiz bot is independent from demonstration bots. Admin must enable it and import a theme.
TUSOVA_QUIZ_ENABLED=false
# RADIO_WORKER_URL=http://127.0.0.1:3006
# RADIO_WORKER_TOKEN=generate_a_random_secret_at_least_32_characters
# RADIO_STORAGE_DIR=storage/radio
# AITunnel для тестовых партий «Мафии» (ключ хранить только в .env, не коммитить)
AITUNNEL_API_KEY=
# TUSOVA_BOT_DIRECT_USERNAME=medium
# TUSOVA_BOT_MENTION_USERNAME=medium
# Для реальной отправки укажи SMTP_USER/SMTP_PASSWORD и SMTP сервера с TLS.
