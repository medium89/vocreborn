generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ONLINE
  AWAY
  DND
  OFFLINE
}


enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum CommunityJoinPolicy {
  OPEN
  APPROVAL
}

enum CommunityMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum CommunityMembershipStatus {
  PENDING
  APPROVED
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum MembershipRole {
  MEMBER
  MODERATOR
  OWNER
}

enum MessageKind {
  TEXT
  SYSTEM
}

enum ReportReason {
  SPAM
  HARASSMENT
  IMPERSONATION
  ILLEGAL
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

enum AttachmentKind {
  IMAGE
  AUDIO
}

enum AttachmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReactionType {
  LIKE
  DISLIKE
  LAUGH
  DISGUST
  LOVE
  SURPRISE
  SAD
}

enum NotificationType {
  REPLY
  REACTION
  MENTION
  GIFT
  PROFILE_POST
  PROFILE_POST_REPLY
  MUTE
  UNMUTE
  BAN
  UNBAN
  PHOTO_LIKE
  PHOTO_COMMENT
}

enum EconomyEntryType {
  ADMIN_ADJUSTMENT
  QUIZ_REWARD
  RADIO_RESERVE
  RADIO_REFUND
  RADIO_CHARGE
  MESSAGE_RATING
  DAILY_ACTIVITY_CREDIT
  DAILY_FIRST_MESSAGE
  DAILY_FIRST_REPLY
  DAILY_PROFILE_COMMENT
  DAILY_PHOTO_LIKE
  DAILY_PROFILE_POST_LIKE
  COMMUNITY_CREATION
  GIFT_PURCHASE
  COSMETIC_PURCHASE
  VIDEO_QUEUE
}

enum DailyActivityAction {
  FIRST_MESSAGE
  FIRST_REPLY
  PROFILE_COMMENT
  PHOTO_LIKE
  PROFILE_POST_LIKE
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  username        String            @unique @db.VarChar(32)
  email           String?           @unique @db.VarChar(254)
  emailVerifiedAt DateTime?         @map("email_verified_at")
  displayName     String            @db.VarChar(64)
  passwordHash    String?           @map("password_hash") @db.VarChar(255)
  isGuest         Boolean           @default(false) @map("is_guest")
  isBot           Boolean           @default(false) @map("is_bot")
  gender          Gender            @default(UNSPECIFIED)
  bio             String?           @db.VarChar(500)
  avatarKey       String?           @map("avatar_key") @db.VarChar(255)
  avatarThumbKey  String?           @map("avatar_thumb_key") @db.VarChar(255)
  role            UserRole          @default(USER)
  hideRole        Boolean           @default(false) @map("hide_role")
  hideDj          Boolean           @default(false) @map("hide_dj")
  isDj            Boolean           @default(false) @map("is_dj")
  status          UserStatus        @default(OFFLINE)
  participantBadge String            @default("member") @map("participant_badge") @db.VarChar(48)
  createdAt       DateTime          @default(now()) @map("created_at")
  participantBadgeIcon String         @default("") @map("participant_badge_icon") @db.VarChar(16)
  updatedAt       DateTime          @updatedAt @map("updated_at")
  participantBadgeOutlined Boolean       @default(true) @map("participant_badge_outlined")
  participantBadgeBackgroundColor String @default("") @map("participant_badge_background_color") @db.VarChar(7)
  participantBadgeBorderColor String     @default("") @map("participant_badge_border_color") @db.VarChar(7)
  deletedAt       DateTime?         @map("deleted_at")
  rating          Int               @default(0)
  credits         Int               @default(20)
  lastRatingAt    DateTime?         @map("last_rating_at")
  ratingAwardDay  DateTime?         @map("rating_award_day")
  ratingAwardsToday Int              @default(0) @map("rating_awards_today")
  sessions        Session[]
  recoveryCodes   RecoveryCode[]
  emailTokens     EmailToken[]
  memberships     RoomMembership[]
  createdRooms    Room[]            @relation("RoomCreator")
  videoQueueItems VideoRoomQueueItem[] @relation("VideoQueueOwner")
  messages        Message[]         @relation("MessageAuthor")
  received        Message[]         @relation("DirectRecipient")
  mutesGiven      Mute[]            @relation("MuteModerator")
  mutes           Mute[]            @relation("MutedUser")
  chaosGiven      Chaos[]           @relation("ChaosModerator")
  chaos           Chaos[]           @relation("ChaosUser")
  bansGiven       Ban[]             @relation("BanModerator")
  bans            Ban[]             @relation("BannedUser")
  reportsCreated  Report[]          @relation("ReportReporter")
  reportsReceived Report[]          @relation("ReportTargetUser")
  reportsHandled  Report[]          @relation("ReportHandler")
  auditActions    ModerationAudit[] @relation("AuditActor")
  auditTargets    ModerationAudit[] @relation("AuditTargetUser")
  attachments     Attachment[]
  photoAlbums     PhotoAlbum[]
  profilePosts    ProfilePost[]     @relation("ProfileOwner")
  communitiesCreated Community[]     @relation("CommunityCreator")
  communityMemberships CommunityMembership[]
  communityPosts CommunityPost[]    @relation("CommunityPostAuthor")
  communityMessages CommunityMessage[]
  receivedGifts GiftInventory[]     @relation("ReceivedGifts")
  sentGifts GiftInventory[]         @relation("SentGifts")
  authoredPosts        ProfilePost[]     @relation("ProfilePostAuthor")
  reactions            MessageReaction[]
  photoLikes           PhotoLike[]
  photoComments        PhotoComment[]
  profilePostLikes     ProfilePostLike[]
  notifications        Notification[]     @relation("NotificationRecipient")
  pushSubscriptions    PushSubscription[]
  notificationActions  Notification[]     @relation("NotificationActor")
  economyEntries       EconomyEntry[]
  dailyActivityRewards DailyActivityReward[]
  cosmetics UserCosmetic[]
  supportTickets SupportTicket[]
  friendshipsAsA Friendship[] @relation("FriendshipUserA")
  friendshipsAsB Friendship[] @relation("FriendshipUserB")
  radioRequests RadioRequest[]
  radioUploads RadioUpload[]
  radioBroadcasts RadioBroadcast[]
  quizWins QuizRound[]

  @@map("users")
}

model Friendship {
  id        String   @id @default(uuid()) @db.Uuid
  userAId   String   @map("user_a_id") @db.Uuid
  userBId   String   @map("user_b_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  userA     User     @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId, createdAt])
  @@map("friendships")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(128)
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  purpose   String    @db.VarChar(16)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_tokens")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@map("recovery_codes")
}

model Room {
  id          String           @id @db.VarChar(64)
  name        String           @db.VarChar(80)
  description String           @default("") @db.VarChar(300)
  tone        String           @default("lime") @db.VarChar(24)
  coverEmoji  String           @default("✦") @map("cover_emoji") @db.VarChar(12)
  coverKey    String?          @map("cover_key") @db.VarChar(255)
  coverThumbKey String?        @map("cover_thumb_key") @db.VarChar(255)
  rules       String           @default("") @db.VarChar(1000)
  visibility  RoomVisibility   @default(PUBLIC)
  isVideoRoom Boolean          @default(false) @map("is_video_room")
  position    Int              @default(0)
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  createdBy   User?            @relation("RoomCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships RoomMembership[]
  messages    Message[]
  videoSession VideoRoomSession?
  videoQueueItems VideoRoomQueueItem[]

  @@map("rooms")
}

model VideoRoomSession {
  roomId       String    @id @map("room_id") @db.VarChar(64)
  provider     String?   @db.VarChar(16)
  videoUrl     String?   @map("video_url") @db.Text
  controllerId String?   @map("controller_id") @db.Uuid
  currentItemId String?  @map("current_item_id") @db.Uuid
  position     Float     @default(0)
  playing      Boolean   @default(false)
  updatedAt    DateTime  @updatedAt @map("updated_at")
  room         Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("video_room_sessions")
}

model VideoRoomQueueItem {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.VarChar(64)
  ownerId   String   @map("owner_id") @db.Uuid
  provider  String   @db.VarChar(16)
  videoUrl  String   @map("video_url") @db.Text
  title     String   @default("") @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  owner     User     @relation("VideoQueueOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt, id])
  @@index([ownerId, createdAt(sort: Desc)])
  @@map("video_room_queue_items")
}

model RoomMembership {
  userId   String         @map("user_id") @db.Uuid
  roomId   String         @map("room_id") @db.VarChar(64)
  role     MembershipRole @default(MEMBER)
  joinedAt DateTime       @default(now()) @map("joined_at")
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  room     Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@index([roomId, joinedAt])
  @@map("room_memberships")
}

model Message {
  quizKind String? @map("quiz_kind") @db.VarChar(16)
  quizRoundId String? @map("quiz_round_id") @db.Uuid
  quizAcceptedAt DateTime? @map("quiz_accepted_at")
  id          String            @id @default(uuid()) @db.Uuid
  authorId    String?           @map("author_id") @db.Uuid
  authorName  String            @map("author_name") @db.VarChar(64)
  roomId      String?           @map("room_id") @db.VarChar(64)
  recipientId String?           @map("recipient_id") @db.Uuid
  body        String            @db.VarChar(1000)
  gifUrl      String?           @map("gif_url") @db.Text
  adminVoice  Boolean           @default(false) @map("admin_voice")
  kind        MessageKind       @default(TEXT)
  requestId   String?           @unique @map("request_id") @db.VarChar(100)
  createdAt   DateTime          @default(now()) @map("created_at")
  editedAt    DateTime?         @map("edited_at")
  deletedAt   DateTime?         @map("deleted_at")
  readAt      DateTime?         @map("read_at")
  replyToId   String?           @map("reply_to_id") @db.Uuid
  author      User?             @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  room        Room?             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  recipient   User?             @relation("DirectRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  reports     Report[]
  auditItems  ModerationAudit[]
  attachments Attachment[]
  reactions   MessageReaction[]
  notifications Notification[]
  replyTo     Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Message[]         @relation("MessageReplies")

  @@index([roomId, createdAt(sort: Desc)])
  @@index([authorId, recipientId, createdAt(sort: Desc)])
  @@index([recipientId, readAt, createdAt(sort: Desc)])
  @@index([replyToId])
  @@index([roomId, quizAcceptedAt, id])
  @@map("messages")
}


model MessageReaction {
  id        String       @id @default(uuid()) @db.Uuid
  messageId String       @map("message_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId, type])
  @@index([userId, createdAt])
  @@map("message_reactions")
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  actorId      String           @map("actor_id") @db.Uuid
  messageId    String?          @map("message_id") @db.Uuid
  profilePostId String?         @map("profile_post_id") @db.Uuid
  giftInventoryId String?       @map("gift_inventory_id") @db.Uuid
  photoId      String?          @map("photo_id") @db.Uuid
  type         NotificationType
  reactionType ReactionType?    @map("reaction_type")
  metadata     Json?
  readAt       DateTime?        @map("read_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  user         User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor        User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  message      Message?         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profilePost  ProfilePost?     @relation(fields: [profilePostId], references: [id], onDelete: Cascade)
  giftInventory GiftInventory?  @relation(fields: [giftInventoryId], references: [id], onDelete: Cascade)
  photo        AlbumPhoto?      @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, actorId, messageId, type])
  @@index([userId, actorId, profilePostId, type])
  @@index([userId, actorId, photoId, type])
  @@map("notifications")
}

model Attachment {
  id           String           @id @default(uuid()) @db.Uuid
  uploaderId   String           @map("uploader_id") @db.Uuid
  messageId    String?          @map("message_id") @db.Uuid
  kind         AttachmentKind
  status       AttachmentStatus @default(PENDING)
  mimeType     String           @map("mime_type") @db.VarChar(100)
  originalName String           @map("original_name") @db.VarChar(255)
  storageKey   String           @unique @map("storage_key") @db.VarChar(255)
  previewStorageKey String?     @unique @map("preview_storage_key") @db.VarChar(255)
  size         Int
  createdAt    DateTime         @default(now()) @map("created_at")
  reviewedAt   DateTime?        @map("reviewed_at")
  uploader     User             @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message      Message?         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profilePostId String?          @unique @map("profile_post_id") @db.Uuid
  profilePost   ProfilePost? @relation(fields: [profilePostId], references: [id], onDelete: Cascade)
  communityMessageId String? @unique @map("community_message_id") @db.Uuid
  communityMessage CommunityMessage? @relation(fields: [communityMessageId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([uploaderId, createdAt])
  @@map("attachments")
}

model PhotoAlbum {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  title     String       @db.VarChar(80)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos    AlbumPhoto[]

  @@index([userId, createdAt])
  @@map("photo_albums")
}

model AlbumPhoto {
  id           String     @id @default(uuid()) @db.Uuid
  albumId      String     @map("album_id") @db.Uuid
  originalName String     @map("original_name") @db.VarChar(255)
  storageKey   String     @unique @map("storage_key") @db.VarChar(255)
  thumbnailKey String     @unique @map("thumbnail_key") @db.VarChar(255)
  size         Int
  createdAt    DateTime   @default(now()) @map("created_at")
  album        PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  likes        PhotoLike[]
  comments     PhotoComment[]
  notifications Notification[]

  @@index([albumId, createdAt])
  @@map("album_photos")
}
model PhotoLike {
  id String @id @default(uuid()) @db.Uuid
  photoId String @map("photo_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  photo AlbumPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([photoId, userId])
  @@index([userId, createdAt])
  @@map("photo_likes")
}

model PhotoComment {
  id String @id @default(uuid()) @db.Uuid
  photoId String @map("photo_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  body String @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  photo AlbumPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@index([photoId, createdAt])
  @@map("photo_comments")
}

model ProfilePost {
  id            String        @id @default(uuid()) @db.Uuid
  profileUserId String        @map("profile_user_id") @db.Uuid
  authorId      String        @map("author_id") @db.Uuid
  parentId      String?       @map("parent_id") @db.Uuid
  body          String        @db.VarChar(500)
  createdAt     DateTime      @default(now()) @map("created_at")
  deletedAt     DateTime?     @map("deleted_at")
  profileUser   User          @relation("ProfileOwner", fields: [profileUserId], references: [id], onDelete: Cascade)
  author        User          @relation("ProfilePostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent        ProfilePost?  @relation("ProfilePostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ProfilePost[] @relation("ProfilePostReplies")
  attachment    Attachment?
  notifications Notification[]
  likes         ProfilePostLike[]

  @@index([profileUserId, createdAt(sort: Desc)])
  @@index([parentId, createdAt])
  @@map("profile_posts")
}


model ProfilePostLike {
  id        String      @id @default(uuid()) @db.Uuid
  postId    String      @map("post_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")
  post      ProfilePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("profile_post_likes")
}

model Mute {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  moderatorId String   @map("moderator_id") @db.Uuid
  reason      String?  @db.VarChar(500)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation("MutedUser", fields: [userId], references: [id], onDelete: Cascade)
  moderator   User     @relation("MuteModerator", fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("mutes")
}

model Chaos {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  moderatorId String    @map("moderator_id") @db.Uuid
  reason      String?   @db.VarChar(500)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation("ChaosUser", fields: [userId], references: [id], onDelete: Cascade)
  moderator   User      @relation("ChaosModerator", fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("chaos")
}

model Ban {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  moderatorId String    @map("moderator_id") @db.Uuid
  reason      String?   @db.VarChar(500)
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  moderator   User      @relation("BanModerator", fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("bans")
}

model SupportTicket {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  subject    String    @db.VarChar(120)
  message    String    @db.VarChar(4000)
  status     String    @default("OPEN") @db.VarChar(16)
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("support_tickets")
}

model Report {
  id             String            @id @default(uuid()) @db.Uuid
  reporterId     String            @map("reporter_id") @db.Uuid
  targetUserId   String?           @map("target_user_id") @db.Uuid
  messageId      String?           @map("message_id") @db.Uuid
  reason         ReportReason
  details        String?           @db.VarChar(1000)
  status         ReportStatus      @default(OPEN)
  handledById    String?           @map("handled_by_id") @db.Uuid
  resolution     String?           @db.VarChar(1000)
  createdAt      DateTime          @default(now()) @map("created_at")
  resolvedAt     DateTime?         @map("resolved_at")
  reporter       User              @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser     User?             @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  message        Message?          @relation(fields: [messageId], references: [id], onDelete: Restrict)
  handledBy      User?             @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)
  auditItems     ModerationAudit[]

  @@index([status, createdAt(sort: Desc)])
  @@index([reporterId, createdAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@map("reports")
}

model ModerationAudit {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  action       String   @db.VarChar(64)
  targetUserId String?  @map("target_user_id") @db.Uuid
  messageId    String?  @map("message_id") @db.Uuid
