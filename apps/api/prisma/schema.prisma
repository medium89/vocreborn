generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ONLINE
  AWAY
  DND
  OFFLINE
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum CommunityJoinPolicy {
  OPEN
  APPROVAL
}

enum CommunityMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum CommunityMembershipStatus {
  PENDING
  APPROVED
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum MembershipRole {
  MEMBER
  MODERATOR
  OWNER
}

enum MessageKind {
  TEXT
  SYSTEM
}

enum ReportReason {
  SPAM
  HARASSMENT
  IMPERSONATION
  ILLEGAL
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

enum AttachmentKind {
  IMAGE
  AUDIO
}

enum AttachmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReactionType {
  LIKE
  DISLIKE
  LAUGH
  DISGUST
  LOVE
  SURPRISE
  SAD
}

enum NotificationType {
  REPLY
  REACTION
  MENTION
  GIFT
  PROFILE_POST
  PROFILE_POST_REPLY
  MUTE
  UNMUTE
  BAN
  UNBAN
  PHOTO_LIKE
  PHOTO_COMMENT
}

enum EconomyEntryType {
  MESSAGE_RATING
  DAILY_ACTIVITY_CREDIT
  GIFT_PURCHASE
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  username        String            @unique @db.VarChar(32)
  displayName     String            @db.VarChar(64)
  passwordHash    String?           @map("password_hash") @db.VarChar(255)
  isGuest         Boolean           @default(false) @map("is_guest")
  isBot           Boolean           @default(false) @map("is_bot")
  gender          Gender            @default(UNSPECIFIED)
  bio             String?           @db.VarChar(500)
  avatarKey       String?           @map("avatar_key") @db.VarChar(255)
  avatarThumbKey  String?           @map("avatar_thumb_key") @db.VarChar(255)
  role            UserRole          @default(USER)
  status          UserStatus        @default(OFFLINE)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")
  rating          Int               @default(0)
  credits         Int               @default(20)
  lastRatingAt    DateTime?         @map("last_rating_at")
  ratingAwardDay  DateTime?         @map("rating_award_day")
  ratingAwardsToday Int              @default(0) @map("rating_awards_today")
  sessions        Session[]
  recoveryCodes   RecoveryCode[]
  memberships     RoomMembership[]
  createdRooms    Room[]            @relation("RoomCreator")
  messages        Message[]         @relation("MessageAuthor")
  received        Message[]         @relation("DirectRecipient")
  mutesGiven      Mute[]            @relation("MuteModerator")
  mutes           Mute[]            @relation("MutedUser")
  bansGiven       Ban[]             @relation("BanModerator")
  bans            Ban[]             @relation("BannedUser")
  reportsCreated  Report[]          @relation("ReportReporter")
  reportsReceived Report[]          @relation("ReportTargetUser")
  reportsHandled  Report[]          @relation("ReportHandler")
  auditActions    ModerationAudit[] @relation("AuditActor")
  auditTargets    ModerationAudit[] @relation("AuditTargetUser")
  attachments     Attachment[]
  photoAlbums     PhotoAlbum[]
  profilePosts    ProfilePost[]     @relation("ProfileOwner")
  communitiesCreated Community[]     @relation("CommunityCreator")
  communityMemberships CommunityMembership[]
  communityPosts CommunityPost[]    @relation("CommunityPostAuthor")
  receivedGifts GiftInventory[]     @relation("ReceivedGifts")
  sentGifts GiftInventory[]         @relation("SentGifts")
  authoredPosts        ProfilePost[]     @relation("ProfilePostAuthor")
  reactions            MessageReaction[]
  photoLikes           PhotoLike[]
  photoComments        PhotoComment[]
  notifications        Notification[]     @relation("NotificationRecipient")
  notificationActions  Notification[]     @relation("NotificationActor")
  economyEntries       EconomyEntry[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(128)
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@map("recovery_codes")
}

model Room {
  id          String           @id @db.VarChar(64)
  name        String           @db.VarChar(80)
  description String           @default("") @db.VarChar(300)
  tone        String           @default("lime") @db.VarChar(24)
  coverEmoji  String           @default("✦") @map("cover_emoji") @db.VarChar(12)
  coverKey    String?          @map("cover_key") @db.VarChar(255)
  coverThumbKey String?        @map("cover_thumb_key") @db.VarChar(255)
  rules       String           @default("") @db.VarChar(1000)
  visibility  RoomVisibility   @default(PUBLIC)
  position    Int              @default(0)
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  createdBy   User?            @relation("RoomCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships RoomMembership[]
  messages    Message[]

  @@map("rooms")
}

model RoomMembership {
  userId   String         @map("user_id") @db.Uuid
  roomId   String         @map("room_id") @db.VarChar(64)
  role     MembershipRole @default(MEMBER)
  joinedAt DateTime       @default(now()) @map("joined_at")
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  room     Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@index([roomId, joinedAt])
  @@map("room_memberships")
}

model Message {
  id          String            @id @default(uuid()) @db.Uuid
  authorId    String?           @map("author_id") @db.Uuid
  authorName  String            @map("author_name") @db.VarChar(64)
  roomId      String?           @map("room_id") @db.VarChar(64)
  recipientId String?           @map("recipient_id") @db.Uuid
  body        String            @db.VarChar(1000)
  kind        MessageKind       @default(TEXT)
  requestId   String?           @unique @map("request_id") @db.VarChar(100)
  createdAt   DateTime          @default(now()) @map("created_at")
  editedAt    DateTime?         @map("edited_at")
  deletedAt   DateTime?         @map("deleted_at")
  readAt      DateTime?         @map("read_at")
  replyToId   String?           @map("reply_to_id") @db.Uuid
  author      User?             @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  room        Room?             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  recipient   User?             @relation("DirectRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  reports     Report[]
  auditItems  ModerationAudit[]
  attachments Attachment[]
  reactions   MessageReaction[]
  notifications Notification[]
  replyTo     Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Message[]         @relation("MessageReplies")

  @@index([roomId, createdAt(sort: Desc)])
  @@index([authorId, recipientId, createdAt(sort: Desc)])
  @@index([recipientId, readAt, createdAt(sort: Desc)])
  @@index([replyToId])
  @@map("messages")
}


model MessageReaction {
  id        String       @id @default(uuid()) @db.Uuid
  messageId String       @map("message_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId, type])
  @@index([userId, createdAt])
  @@map("message_reactions")
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  actorId      String           @map("actor_id") @db.Uuid
  messageId    String?          @map("message_id") @db.Uuid
  profilePostId String?         @map("profile_post_id") @db.Uuid
  giftInventoryId String?       @map("gift_inventory_id") @db.Uuid
  photoId      String?          @map("photo_id") @db.Uuid
  type         NotificationType
  reactionType ReactionType?    @map("reaction_type")
  metadata     Json?
  readAt       DateTime?        @map("read_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  user         User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor        User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  message      Message?         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profilePost  ProfilePost?     @relation(fields: [profilePostId], references: [id], onDelete: Cascade)
  giftInventory GiftInventory?  @relation(fields: [giftInventoryId], references: [id], onDelete: Cascade)
  photo        AlbumPhoto?      @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, actorId, messageId, type])
  @@index([userId, actorId, profilePostId, type])
  @@index([userId, actorId, photoId, type])
  @@map("notifications")
}

model Attachment {
  id           String           @id @default(uuid()) @db.Uuid
  uploaderId   String           @map("uploader_id") @db.Uuid
  messageId    String           @map("message_id") @db.Uuid
  kind         AttachmentKind
  status       AttachmentStatus @default(PENDING)
  mimeType     String           @map("mime_type") @db.VarChar(100)
  originalName String           @map("original_name") @db.VarChar(255)
  storageKey   String           @unique @map("storage_key") @db.VarChar(255)
  previewStorageKey String?     @unique @map("preview_storage_key") @db.VarChar(255)
  size         Int
  createdAt    DateTime         @default(now()) @map("created_at")
  reviewedAt   DateTime?        @map("reviewed_at")
  uploader     User             @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message      Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profilePostId String?          @unique @map("profile_post_id") @db.Uuid
  profilePost   ProfilePost?     @relation(fields: [profilePostId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([uploaderId, createdAt])
  @@map("attachments")
}

model PhotoAlbum {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  title     String       @db.VarChar(80)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos    AlbumPhoto[]

  @@index([userId, createdAt])
  @@map("photo_albums")
}

model AlbumPhoto {
  id           String     @id @default(uuid()) @db.Uuid
  albumId      String     @map("album_id") @db.Uuid
  originalName String     @map("original_name") @db.VarChar(255)
  storageKey   String     @unique @map("storage_key") @db.VarChar(255)
  thumbnailKey String     @unique @map("thumbnail_key") @db.VarChar(255)
  size         Int
  createdAt    DateTime   @default(now()) @map("created_at")
  album        PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  likes        PhotoLike[]
  comments     PhotoComment[]
  notifications Notification[]

  @@index([albumId, createdAt])
  @@map("album_photos")
}
model PhotoLike {
  id String @id @default(uuid()) @db.Uuid
  photoId String @map("photo_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  photo AlbumPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([photoId, userId])
  @@index([userId, createdAt])
  @@map("photo_likes")
}

model PhotoComment {
  id String @id @default(uuid()) @db.Uuid
  photoId String @map("photo_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  body String @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  photo AlbumPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@index([photoId, createdAt])
  @@map("photo_comments")
}

model ProfilePost {
  id            String        @id @default(uuid()) @db.Uuid
  profileUserId String        @map("profile_user_id") @db.Uuid
  authorId      String        @map("author_id") @db.Uuid
  parentId      String?       @map("parent_id") @db.Uuid
  body          String        @db.VarChar(500)
  createdAt     DateTime      @default(now()) @map("created_at")
  deletedAt     DateTime?     @map("deleted_at")
  profileUser   User          @relation("ProfileOwner", fields: [profileUserId], references: [id], onDelete: Cascade)
  author        User          @relation("ProfilePostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent        ProfilePost?  @relation("ProfilePostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ProfilePost[] @relation("ProfilePostReplies")
  attachment    Attachment?
  notifications Notification[]

  @@index([profileUserId, createdAt(sort: Desc)])
  @@index([parentId, createdAt])
  @@map("profile_posts")
}

model Mute {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  moderatorId String   @map("moderator_id") @db.Uuid
  reason      String?  @db.VarChar(500)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation("MutedUser", fields: [userId], references: [id], onDelete: Cascade)
  moderator   User     @relation("MuteModerator", fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("mutes")
}

model Ban {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  moderatorId String    @map("moderator_id") @db.Uuid
  reason      String?   @db.VarChar(500)
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  moderator   User      @relation("BanModerator", fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("bans")
}

model Report {
  id             String            @id @default(uuid()) @db.Uuid
  reporterId     String            @map("reporter_id") @db.Uuid
  targetUserId   String?           @map("target_user_id") @db.Uuid
  messageId      String?           @map("message_id") @db.Uuid
  reason         ReportReason
  details        String?           @db.VarChar(1000)
  status         ReportStatus      @default(OPEN)
  handledById    String?           @map("handled_by_id") @db.Uuid
  resolution     String?           @db.VarChar(1000)
  createdAt      DateTime          @default(now()) @map("created_at")
  resolvedAt     DateTime?         @map("resolved_at")
  reporter       User              @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser     User?             @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  message        Message?          @relation(fields: [messageId], references: [id], onDelete: Restrict)
  handledBy      User?             @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)
  auditItems     ModerationAudit[]

  @@index([status, createdAt(sort: Desc)])
  @@index([reporterId, createdAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@map("reports")
}

model ModerationAudit {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  action       String   @db.VarChar(64)
  targetUserId String?  @map("target_user_id") @db.Uuid
  messageId    String?  @map("message_id") @db.Uuid
  reportId     String?  @map("report_id") @db.Uuid
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser   User?    @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  message      Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  report       Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("moderation_audit")
}

model Community {
  id          String                @id @default(uuid()) @db.Uuid
  name        String                @db.VarChar(80)
  description String                @default("") @db.VarChar(300)
  joinPolicy  CommunityJoinPolicy   @default(OPEN) @map("join_policy")
  createdById String                @map("created_by_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  createdBy   User                  @relation("CommunityCreator", fields: [createdById], references: [id], onDelete: Cascade)
  memberships CommunityMembership[]
  posts       CommunityPost[]

  @@index([createdAt])
  @@map("communities")
}

model CommunityMembership {
  communityId String                    @map("community_id") @db.Uuid
  userId      String                    @map("user_id") @db.Uuid
  role        CommunityMemberRole       @default(MEMBER)
  status      CommunityMembershipStatus @default(APPROVED)
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  community   Community                 @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId, status])
  @@index([communityId, status])
  @@map("community_memberships")
}

model CommunityPost {
  id          String    @id @default(uuid()) @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  body        String    @db.VarChar(2000)
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      User      @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt(sort: Desc)])
  @@map("community_posts")
}


model GiftCatalog {
  id          String          @id @db.VarChar(64)
  name        String          @db.VarChar(80)
  description String          @default("") @db.VarChar(240)
  emoji       String          @db.VarChar(16)
  active      Boolean         @default(true)
  position    Int             @default(0)
  price       Int             @default(5)
  createdAt   DateTime        @default(now()) @map("created_at")
  inventories GiftInventory[]

  @@map("gift_catalog")
}

model GiftInventory {
  id          String      @id @default(uuid()) @db.Uuid
  giftId      String      @map("gift_id") @db.VarChar(64)
  recipientId String      @map("recipient_id") @db.Uuid
  senderId    String?     @map("sender_id") @db.Uuid
  message     String?     @db.VarChar(300)
  createdAt   DateTime    @default(now()) @map("created_at")
  gift        GiftCatalog @relation(fields: [giftId], references: [id], onDelete: Restrict)
  recipient   User        @relation("ReceivedGifts", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User?       @relation("SentGifts", fields: [senderId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
  @@map("gift_inventory")
}

model EconomyEntry {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  type          EconomyEntryType
  ratingDelta   Int              @default(0) @map("rating_delta")
  creditsDelta  Int              @default(0) @map("credits_delta")
  balanceAfter  Int              @map("balance_after")
  messageId     String?          @unique @map("message_id") @db.Uuid
  giftId        String?          @map("gift_id") @db.VarChar(64)
  createdAt     DateTime         @default(now()) @map("created_at")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("economy_entries")
}
