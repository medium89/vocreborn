{
  "name": "@vocreborn/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "user:role": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/set-role.ts",
    "test:integration": "npm run build && node --test test/api.integration.test.mjs",
    "test:realtime": "npm run build && node --test test/realtime.integration.test.mjs",
    "test:moderation": "npm run build && node --test test/moderation-immunity.integration.test.mjs",
    "test:admin": "npm run build && node --test test/admin.integration.test.mjs",
    "test:radio": "npm run build && node --test test/radio.integration.test.mjs",
    "test:quiz": "npm run build && node --test test/quiz.rules.test.mjs test/quiz.integration.test.mjs"
  },
  "prisma": {
    "seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/websockets": "^11.1.6",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/cookie-parser": "^1.4.9",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.2",
    "prisma": "6.12.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0"
  }
}
